<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ProjectName>Aviationexam.GeneratedJsonConverters.Abstractions</ProjectName>
    <RootNamespace>Aviationexam.GeneratedJsonConverters</RootNamespace>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <Import Project="..\WarningConfiguration.targets" />

  <PropertyGroup Label="NuGet">
    <PackageLicense>MIT</PackageLicense>
    <RepositoryUrl>https://github.com/aviationexam/json-converter-source-generator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- netstandard2.0 has no assembly of its own; the placeholder keeps the dependency group valid -->
    <None Include="_._" Pack="true" PackagePath="lib/netstandard2.0" Visible="false" />
  </ItemGroup>

  <!--
    netstandard2.0 consumers compile and run against Aviationexam.GeneratedJsonConverters.Abstractions.NetStandard, built from these sources.
    net8.0+ consumers compile against this assembly and also get the NetStandard one at runtime only,
    so a netstandard2.0 library keeps the types it was compiled against inside a net8.0+ application.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <ProjectReference Include="..\Aviationexam.GeneratedJsonConverters.Abstractions.NetStandard\Aviationexam.GeneratedJsonConverters.Abstractions.NetStandard.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <ProjectReference Include="..\Aviationexam.GeneratedJsonConverters.Abstractions.NetStandard\Aviationexam.GeneratedJsonConverters.Abstractions.NetStandard.csproj" Aliases="NetStandard" PrivateAssets="compile;contentfiles;analyzers;build" />
  </ItemGroup>

</Project>
