<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A separate assembly, so a netstandard2.0 library keeps binding to it inside a net8.0+ application.
      The net8.0 build has the same netstandard2.0 shape (ABSTRACTIONS_NETSTANDARD) and only exists so net8.0+ applications
      load it with the framework System.Text.Json instead of the netstandard2.0 package dependencies.
    -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <DefineConstants>$(DefineConstants);ABSTRACTIONS_NETSTANDARD</DefineConstants>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ProjectName>Aviationexam.GeneratedJsonConverters.Abstractions.NetStandard</ProjectName>
    <RootNamespace>Aviationexam.GeneratedJsonConverters</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <Import Project="..\WarningConfiguration.targets" />

  <PropertyGroup Label="NuGet">
    <PackageLicense>MIT</PackageLicense>
    <RepositoryUrl>https://github.com/aviationexam/json-converter-source-generator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Aviationexam.GeneratedJsonConverters.Abstractions\**\*.cs" Exclude="..\Aviationexam.GeneratedJsonConverters.Abstractions\obj\**;..\Aviationexam.GeneratedJsonConverters.Abstractions\bin\**" LinkBase="Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
